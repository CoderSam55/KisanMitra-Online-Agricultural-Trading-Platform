PORT=5000

# Supabase Postgres connection. Keep the password URL-encoded if it has special characters.
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-database-password
DATABASE_DRIVER=org.postgresql.Driver

# Server-side signing secret for KisanMitra API tokens (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=2592000000
CLIENT_URL=http://localhost:5173

# Supabase project URL and a server-side Auth API key. Prefer the anon/publishable key;
# the service-role key is supported as a backend-only fallback and must never reach the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=listing-images
